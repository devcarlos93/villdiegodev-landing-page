---
import { Globe } from 'lucide-astro';
---

<div class="fixed top-6 right-6 z-50 language-toggle">
  <button 
    id="lang-toggle"
    class="flex items-center gap-2 px-4 py-2 rounded-full bg-kineon-card-bg border border-kineon-border hover:border-kineon-turquoise transition-all duration-300"
    aria-label="Toggle language"
  >
    <Globe size={20} class="text-kineon-turquoise" />
    <span class="text-kineon-text-primary font-semibold text-sm" id="current-lang">ES</span>
  </button>
</div>

<style>
  .language-toggle button:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(0, 217, 181, 0.2);
  }
</style>

<script>
  const langToggle = document.getElementById('lang-toggle');
  const currentLangSpan = document.getElementById('current-lang');
  const htmlElement = document.documentElement;

  // Get saved language preference or default to Spanish
  let currentLang = localStorage.getItem('kineon-lang') || 'es';
  
  // Set initial language
  htmlElement.setAttribute('lang', currentLang);
  currentLangSpan!.textContent = currentLang.toUpperCase();
  updateContent(currentLang);

  // Toggle language on click
  langToggle?.addEventListener('click', () => {
    currentLang = currentLang === 'es' ? 'en' : 'es';
    htmlElement.setAttribute('lang', currentLang);
    currentLangSpan!.textContent = currentLang.toUpperCase();
    localStorage.setItem('kineon-lang', currentLang);
    updateContent(currentLang);
  });

  function updateContent(lang: string) {
    // Hide all language-specific content
    document.querySelectorAll('[data-lang]').forEach(el => {
      (el as HTMLElement).style.display = 'none';
    });
    
    // Show content for selected language
    document.querySelectorAll(`[data-lang="${lang}"]`).forEach(el => {
      (el as HTMLElement).style.display = 'block';
    });
  }
</script>
