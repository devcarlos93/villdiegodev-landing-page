---
import { ChevronDown } from 'lucide-astro';
import { HeroGeometric } from './ui/shape-landing-hero';
---

<HeroGeometric client:load>
  <div class="section-container relative z-10 w-full">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <!-- Content -->
      <div class="space-y-6 hero-content">
        <div class="space-y-2">
          <p class="text-lg md:text-xl text-white/60 font-medium">Hola, soy</p>
          <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl font-black leading-tight">
            Carlos
            <span class="block gradient-text">Villadiego</span>
          </h1>
        </div>
        
        <p class="text-xl md:text-2xl text-white/80 font-medium">
          Front End Developer
        </p>
        
        <p class="text-lg text-white/60 max-w-xl">
          Desarrollador frontend especializado en Angular e Ionic. Construyendo aplicaciones empresariales robustas con código limpio y arquitectura mantenible. Explorando Flutter y potenciando mi flujo de trabajo con AI.
        </p>

        <div class="flex flex-wrap gap-4 pt-4">
          <a href="#proyectos" class="btn-primary">
            Ver Proyectos
          </a>
          <a href="#perfil" class="btn-secondary">
            Conocer Más
          </a>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-3 gap-6 pt-8">
          <div class="stat-card">
            <div class="text-3xl md:text-4xl font-bold gradient-text">5+</div>
            <div class="text-sm text-white/60">Años</div>
          </div>
          <div class="stat-card">
            <div class="text-3xl md:text-4xl font-bold gradient-text">20+</div>
            <div class="text-sm text-white/60">Proyectos</div>
          </div>
          <div class="stat-card">
            <div class="text-3xl md:text-4xl font-bold gradient-text">10+</div>
            <div class="text-sm text-white/60">Clientes</div>
          </div>
        </div>
      </div>

      <!-- Profile Image -->
      <div class="flex justify-center hero-image">
        <div class="relative">
          <!-- Strong Cyan Glow on Right Side -->
          <div class="absolute top-0 -right-20 w-96 h-96 bg-gradient-to-l from-cyan-500 via-cyan-400 to-transparent rounded-full blur-3xl opacity-60"></div>
          
          <!-- Orange Glow on Left -->
          <div class="absolute top-0 -left-20 w-80 h-80 bg-gradient-to-r from-orange-500 via-orange-400 to-transparent rounded-full blur-3xl opacity-40"></div>
          
          <!-- Image Container with Shadow -->
          <div class="relative w-80 h-80 md:w-96 md:h-96 rounded-full overflow-hidden border-4 border-white/20 shadow-2xl">
            <img 
              src="/profile.png" 
              alt="Carlos Villadiego"
              class="w-full h-full object-cover"
            />
            <!-- Cyan Light Overlay on Image -->
            <div class="absolute inset-0 bg-gradient-to-l from-cyan-500/30 via-transparent to-transparent"></div>
          </div>
          
          <!-- Decorative Rings -->
          <div class="absolute -inset-4 border-2 border-cyan-400/30 rounded-full"></div>
          <div class="absolute -inset-8 border border-orange-400/20 rounded-full"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div slot="after" class="absolute bottom-8 left-1/2 -translate-x-1/2 scroll-indicator z-20">
    <a href="#perfil" class="scroll-button group">
      <ChevronDown size={20} class="text-white/80 group-hover:text-white transition-colors" />
    </a>
  </div>
</HeroGeometric>

<style>
  .stat-card {
    text-align: center;
  }

  .scroll-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.3s ease;
    animation: float-gentle 3s ease-in-out infinite;
  }

  .scroll-button:hover {
    transform: translateY(-4px) scale(1.1);
    background: rgba(255, 107, 53, 0.1);
    border-color: rgba(255, 107, 53, 0.3);
    box-shadow: 
      0 8px 24px rgba(255, 107, 53, 0.25),
      0 0 40px rgba(255, 107, 53, 0.15);
  }

  @keyframes float-gentle {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }
</style>