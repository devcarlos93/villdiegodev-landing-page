                    </svg>
                    <span class="lang-es">Contacto</span>
                    <span class="lang-en hidden">Contact</span>
                </a>
                <a href="https://apps.apple.com/app/trackio" class="link-item">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                    </svg>
                    <span class="lang-es">Descargar App</span>
                    <span class="lang-en hidden">Download App</span>
                </a>
            </div>
        </section>

        <!-- Footer -->
        <footer class="footer">
            <p>&copy; 2025 Trackio. <span class="lang-es">Todos los derechos reservados.</span><span class="lang-en hidden">All rights reserved.</span></p>
            <p class="version">Version 1.0.0</p>
            <div class="social-links">
